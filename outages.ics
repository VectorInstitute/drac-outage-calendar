BEGIN:VEVENT
SUMMARY:[DRAC] Arbutus Storage Expansion
DTSTART;TZID=America/Toronto:20200206T180900
DTEND;TZID=America/Toronto:20200213T185400
DTSTAMP:20260703T134918Z
UID:drac-incident-393@status.alliancecan.ca
CATEGORIES:UNPLANNED
DESCRIPTION:Please be aware that we are performing an expansion of storage
